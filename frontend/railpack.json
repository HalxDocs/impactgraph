{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "commands": ["npm ci"],
      "inputs": ["package.json", "package-lock.json"]
    },
    "build": {
      "commands": ["npm run build"],
      "inputs": ["."]
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist -l $PORT",
    "healthcheckPath": "/"
  }
}
