{
  "$schema": "https://schema.railpack.com",
  "provider": "go",
  "steps": {
    "install": {
      "commands": ["go mod download"],
      "inputs": ["go.mod", "go.sum"]
    },
    "build": {
      "commands": ["go build -o /app/api ./cmd/api"],
      "inputs": ["."]
    }
  },
  "deploy": {
    "startCommand": "/app/api",
    "healthcheckPath": "/api/health"
  }
}
